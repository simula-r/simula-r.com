      "shape:S6257U_yQ9xs_bgwh74lS": {
        "x": 2795.035762422225,
        "y": -315.8059514079269,
        "rotation": 0,
        "isLocked": false,
        "opacity": 1,
        "meta": {},
        "id": "shape:S6257U_yQ9xs_bgwh74lS",
        "type": "text",
        "props": {
          "color": "black",
          "size": "s",
          "w": 617.1151619018439,
          "font": "draw",
