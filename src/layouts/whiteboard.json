          "autoSize": true,
          "scale": 0.7295133875914657,
          "richText": {
            "type": "doc",
            "attrs": {
              "dir": "auto"
            },
            "content": [
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "I remember when the web used to be weirder. Less corporate. Less shit. More human."
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "So I wanted to contribute to that nostalgia. I think I did it justice. A full 3D first person"
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "escape room in the browser. Super custom graphics with that OG PSX style I love so much."
                  }
                ]
              },
              {
                "type": "paragraph",
                "attrs": {
                  "dir": "auto"
                },
                "content": [
                  {
                    "type": "text",
                    "text": "I built my own art pipeline in blender and photoshop to achieve a baked stylized look."
                  }
                ]
              }
            ]
          }
        },
